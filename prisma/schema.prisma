generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN
  AGENCY_MANAGER
  AGENT
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  NEGOTIATING
  SOLD
  RENTED
  ARCHIVED
}

enum DealType {
  SALE
  RENT
  MORTGAGE_RENT
}

enum FollowupType {
  CALL
  MESSAGE
  MEETING
  VISIT
  REMINDER
  TASK
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String?
  role         Role        @default(AGENT)
  agencyId     String?
  agency       Agency?     @relation(fields: [agencyId], references: [id])
  properties   Property[]
  applicants   Applicant[]
  followups    Followup[]
  contracts    Contract[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  createdAt DateTime @default(now())
}

model Owner {
  id         String     @id @default(cuid())
  name       String
  phone      String
  email      String?
  address    String?
  notes      String?
  properties Property[]
  followups  Followup[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Property {
  id        String         @id @default(cuid())
  code      String         @unique
  title     String
  type      String
  dealType  DealType
  status    PropertyStatus @default(DRAFT)
  city      String
  district  String
  address   String?
  latitude  Float?
  longitude Float?
  price     Decimal        @db.Decimal(18, 2)
  deposit   Decimal?       @db.Decimal(18, 2)
  rent      Decimal?       @db.Decimal(18, 2)
  area      Int
  rooms     Int
  floor     Int?
  age       Int?
  features  String[]
  images    String[]
  published Boolean        @default(false)
  ownerId   String
  owner     Owner          @relation(fields: [ownerId], references: [id])
  agentId   String
  agent     User           @relation(fields: [agentId], references: [id])
  contracts Contract[]
  followups Followup[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Applicant {
  id               String     @id @default(cuid())
  name             String
  phone            String
  email            String?
  requestType      DealType
  budgetMin        Decimal?   @db.Decimal(18, 2)
  budgetMax        Decimal?   @db.Decimal(18, 2)
  cities           String[]
  districts        String[]
  propertyTypes    String[]
  minRooms         Int?
  requiredFeatures String[]
  urgency          Int        @default(1)
  status           String     @default("ACTIVE")
  notes            String?
  agentId          String
  agent            User       @relation(fields: [agentId], references: [id])
  contracts        Contract[]
  followups        Followup[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Followup {
  id          String       @id @default(cuid())
  title       String
  type        FollowupType
  scheduledAt DateTime
  priority    Int          @default(1)
  completed   Boolean      @default(false)
  description String?
  assigneeId  String
  assignee    User         @relation(fields: [assigneeId], references: [id])
  ownerId     String?
  owner       Owner?       @relation(fields: [ownerId], references: [id])
  applicantId String?
  applicant   Applicant?   @relation(fields: [applicantId], references: [id])
  propertyId  String?
  property    Property?    @relation(fields: [propertyId], references: [id])
  createdAt   DateTime     @default(now())
}

model Contract {
  id             String    @id @default(cuid())
  number         String    @unique
  type           String
  amount         Decimal   @db.Decimal(18, 2)
  commission     Decimal   @db.Decimal(18, 2)
  contractDate   DateTime
  status         String
  paymentDetails Json?
  notes          String?
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id])
  applicantId    String
  applicant      Applicant @relation(fields: [applicantId], references: [id])
  agentId        String
  agent          User      @relation(fields: [agentId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
